# Function to generate first n Fibonacci numbers
def fibonacci(n):
    a, b = 0, 1
    seq = [a, b]
    for i in range(2, n):
        c = a + b
        seq.append(c)
        a, b = b, c
    return seq

# Function to check if a number is prime
def is_prime(num):
    if num <= 1:
        return False
    if num == 2:
        return True
    if num % 2 == 0:
        return False
    for i in range(3, int(num**0.5) + 1, 2):
        if num % i == 0:
            return False
    return True

# Print first 50 Fibonacci numbers
fib_numbers = fibonacci(50)
print("First 50 Fibonacci numbers:")
print(fib_numbers)

# Example: check if a number is prime
number_to_check = 47
print(f"\nIs {number_to_check} prime? {is_prime(number_to_check)}")
